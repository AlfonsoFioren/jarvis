{
  "name": "jarvis-desktop",
  "productName": "Jarvis",
  "version": "1.1.0",
  "description": "Jarvis - assistente personale IA",
  "main": "main.js",
  "author": "Jarvis",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@huggingface/transformers": "^4.3.2",
    "electron-updater": "^6.3.9",
    "msedge-tts": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "mpg123-decoder": "^1.0.3"
  },
  "build": {
    "appId": "it.personale.jarvis",
    "productName": "Jarvis",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/transformers/dist/*.web*",
      "!node_modules/@huggingface/transformers/dist/ort-*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Jarvis-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ]
  }
}
